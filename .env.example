# Penny works out of the box with local storage (no setup needed).
#
# To enable CLOUD sync across devices, create a free Supabase project
# (https://supabase.com), run supabase/schema.sql in the SQL editor,
# then copy this file to ".env" and fill in the values below.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
